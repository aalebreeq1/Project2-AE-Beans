<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AE Beans | Checkout</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/beans.style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cloudflare.com" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-container">
        <div class="form-card-container">
            <div class="form-card">
                <h2>Complete Your Order</h2>
                <p class="form-subtitle">Provide your delivery details to dispatch your roasts</p>

                <form action="/orders" method="POST" class="bean-form">

                    <div class="form-group">
                        <label for="shipping_address">Delivery Address</label>
                        <input type="text" id="shipping_address" name="shipping_address" required placeholder="e.g. Bldg 123, Road 456, Saar, Bahrain" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label for="shipping_company">Preferred Shipping Partner</label>
                        <select id="shipping_company" name="shipping_company" required class="form-control" style="width: 100%; padding: 10px; border: 1px solid var(--roast-border); border-radius: 6px;">
                            <option value="" disabled selected>Select a logistics provider</option>
                            <% if (typeof shippingCompanies !== 'undefined' && shippingCompanies.length > 0) { %>
                                <% shippingCompanies.forEach(company => { %>
                                    <option value="<%= company._id %>"><%= company.name %> -  <%= company.address %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <input type="hidden" name="total_price" value="15.500"> 

                    <div class="form-actions" style="display: flex; gap: 10px; margin-top: 20px;">
                        <button type="submit" class="btn-primary">Place Order</button>
                        <a href="/beans" class="btn-secondary" style="text-align: center; text-decoration: none; padding: 10px 20px;">Return to Shop</a>
                    </div>

                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>