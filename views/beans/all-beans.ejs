<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AE Beans | All Beans</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/beans.style.css">
</head>

<body>
    <%- include('../partials/navbar') %>

        <main class="main-container">
            <div class="page-header">
                <h2>Our Specialty Coffee Collection</h2>
                <p>Discover freshly roasted beans sourced from around the world.</p>
            </div>

            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="admin-actions-container">
                    <a href="/beans/create">
                        <button class="btn-primary">Add New Bean</button>
                    </a>
                </div>
            <% } %>

            <% if (allBeans && allBeans.length > 0) { %>
                <div class="cards-grid">
                    <% allBeans.forEach(bean => { %>
                        <div class="bean-card" style="position: relative;">
                            <!-- Invisible full-card link overlay except for buttons -->
                            <a href="/beans/<%= bean._id %>" class="card-overlay-link" aria-label="<%= bean.name %> details" style="position: absolute; top: 0; left: 0; width: 100%; height: 70%; z-index: 1;"></a>

                            <div class="bean-image-container">
                                <img src="<%= bean.img_url %>" alt="<%= bean.name %>">
                            </div>

                            <div class="bean-info">
                                <h3>
                                    <%= bean.name %>
                                </h3>
                                <p class="bean-description">
                                    <%= bean.description %>
                                </p>
                                <div class="bean-price-row">
                                    <span class="price">BHD <%= Number(bean.price).toFixed(3) %></span>
                                    <% if (typeof bean.isInCart !== 'undefined' && bean.isInCart) { %>
                                        <span class="badge-cart">In Cart</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="bean-actions" style="position: relative; z-index: 2;">
                                <form action="/cart/add" method="POST" style="width: 100%; display: flex; gap: 5px;">
                                    <input type="hidden" name="itemType" value="Bean">
                                    <input type="hidden" name="itemId" value="<%= bean._id %>">
                                    <input type="hidden" name="quantity" value="1">
                                    <button class="btn-primary" type="submit" style="width: 100%;">Add to Cart</button>
                                </form>

                                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                    <div class="admin-toolbar" style="margin-top: 10px;">
                                        <span class="admin-label">Admin</span>
                                        <div class="admin-buttons">
                                            <a href="/beans/<%= bean._id %>/edit" class="btn-secondary">Edit</a>
                                            <form action="/beans/<%= bean._id %>/delete?_method=DELETE" method="POST" style="display:inline;">
                                                <button class="btn-danger" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No coffee beans available right now. Check back soon!</p>
                </div>
            <% } %>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>