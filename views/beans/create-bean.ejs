<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AE Beans | Add New Bean</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/beans.style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-container">
        <div class="form-card-container">
            <div class="form-card">
                <h2>Add New Coffee Bean</h2>
                <p class="form-subtitle">List a fresh specialty coffee product to the catalog</p>

                <% if (errorMessage) { %>
                    <div class="error-message">
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>

                <form action="/beans" method="POST" class="bean-form">
                    <div class="form-group">
                        <label for="name">Bean Name</label>
                        <input type="text" id="name" name="name" required placeholder="e.g. Ethiopian Yirgacheffe" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="4" required placeholder="Describe origin, flavor notes, and roast profile..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="price">Price (BHD)</label>
                        <input type="number" id="price" name="price"  min="0" required placeholder="18.99" />
                    </div>

                    <div class="form-group">
                        <label for="imageUrl">Image URL</label>
                        <input type="url" id="imageUrl" name="imageUrl" required placeholder="https://images.unsplash.com/..." />
                    </div>

                    <button type="submit" class="btn-primary">Publish Bean</button>
                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>