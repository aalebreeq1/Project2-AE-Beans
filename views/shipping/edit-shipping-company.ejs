<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AE Beans | Edit Shipping Partner</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/beans.style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/navbar') %>

    <main class="main-container">
        <div class="form-card-container">
            <div class="form-card">
                <h2>Edit Shipping Partner</h2>
                <p class="form-subtitle">Update logistics provider details</p>

                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="error-message">
                        <span>⚠️</span>
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>

                <form action="/shipping-companies/<%= shippingCompany._id %>/update?_method=PUT" method="POST" class="bean-form">

                    <div class="form-group">
                        <label for="name">Company Name</label>
                        <input type="text" id="name" name="name" value="<%= shippingCompany.name %>" required placeholder="e.g. DHL Express" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label for="address">Address / Hub Location</label>
                        <input type="text" id="address" name="address" value="<%= shippingCompany.address %>" required placeholder="e.g. Sitra Industrial Area, Bahrain" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label for="phone_number">Phone Number</label>
                        <input type="text" id="phone_number" name="phone_number" value="<%= shippingCompany.phone_number %>" required placeholder="e.g. +973 1700 0000" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label for="img_url">Logo / Image URL</label>
                        <input type="url" id="img_url" name="img_url" value="<%= shippingCompany.img_url %>" required placeholder="https://images.unsplash.com/..." />
                    </div>

                    <div class="form-actions" style="display: flex; gap: 10px; margin-top: 20px;">
                        <button type="submit" class="btn-primary">Update Partner</button>
                        <a href="/shipping-companies/<%= shippingCompany._id %>" class="btn-secondary" style="text-align: center; text-decoration: none; padding: 10px 20px;">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>

</html>