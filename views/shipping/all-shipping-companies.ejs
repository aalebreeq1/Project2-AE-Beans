<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AE Beans | Shipping Partners</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/beans.style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-container">
        <div class="catalog-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h2>Our Shipping Partners</h2>
                <p class="catalog-subtitle">Reliable logistics providers delivering your specialty coffee and gear</p>
            </div>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="admin-actions-container">
                    <a href="/shipping-companies/create" class="btn-primary" style="text-decoration: none;">Add Shipping Partner</a>
                </div>
            <% } %>
        </div>

        <% if (shippingCompanies.length === 0) { %>
            <div class="empty-state" style="text-align: center; padding: 3rem;">
                <p>No shipping companies available at the moment.</p>
            </div>
        <% } else { %>
            <div class="catalog-grid">
                <% shippingCompanies.forEach(company => { %>
                    <div class="bean-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div class="bean-image-container" style="height: 180px; overflow: hidden; background: #f9f9f9; display: flex; align-items: center; justify-content: center;">
                                <img src="<%= company.img_url %>" alt="<%= company.name %>" style="width: 100%; height: 100%; object-fit: contain; padding: 10px;" onerror="this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <div class="bean-card-content" style="padding: 1.25rem;">
                                <h3 style="margin-bottom: 0.5rem; font-size: 1.2rem;"><%= company.name %></h3>
                                <p class="origin-tag" style="margin-bottom: 0.4rem;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M20.6211 8.45C19.5711 3.83 15.5411 1.75 12.0011 1.75C12.0011 1.75 12.0011 1.75 11.9911 1.75C8.46107 1.75 4.42107 3.82 3.37107 8.44C2.20107 13.6 5.36107 17.97 8.22107 20.72C9.28107 21.74 10.6411 22.25 12.0011 22.25C13.3611 22.25 14.7211 21.74 15.7711 20.72C18.6311 17.97 21.7911 13.61 20.6211 8.45ZM12.0011 13.46C10.2611 13.46 8.85107 12.05 8.85107 10.31C8.85107 8.57 10.2611 7.16 12.0011 7.16C13.7411 7.16 15.1511 8.57 15.1511 10.31C15.1511 12.05 13.7411 13.46 12.0011 13.46Z" fill="#ffffff"/></svg><%= company.address %></p>
                                <p class="notes-text" style="margin: 0;">📞 <%= company.phone_number %></p>
                            </div>
                        </div>
                        
                        <div class="card-actions" style="padding: 0 1.25rem 1.25rem 1.25rem;">
                            <a href="/shipping-companies/<%= company._id %>" class="btn-secondary" style="display: block; width: 100%; text-align: center; text-decoration: none; box-sizing: border-box;">View Details</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>